/**
 * 数据库健康监控
 *
 * 提供：
 * - 数据库完整性检查
 * - 连接池状态监控
 * - 性能指标监控
 * - 健康检查 API
 */

import { getConnection, type DatabaseConfig } from './connection';
import type { BackupManager } from './backup';

/**
 * 健康检查结果
 */
export interface HealthCheckResult {
  status: 'healthy' | 'degraded' | 'unhealthy';
  checks: HealthCheck[];
  timestamp: Date;
}

/**
 * 单个健康检查结果
 */
export interface HealthCheck {
  name: string;
  status: 'pass' | 'fail' | 'warn';
  message?: string;
  duration?: number;
  metadata?: Record<string, any>;
}

/**
 * 健康监控配置
 */
export interface HealthMonitorConfig {
  enableAutoRepair?: boolean; // 是否启用自动修复
  maxReconnectAttempts?: number; // 最大重连尝试次数
  healthCheckIntervalMs?: number; // 健康检查间隔
}

/**
 * 数据库健康监控器
 */
export class DatabaseHealthMonitor {
  private db = getConnection();
  private config: Required<HealthMonitorConfig>;
  private healthHistory: Array<{
    status: string;
    timestamp: Date;
  }> = [];
  private reconnectAttempts = 0;

  constructor(config: HealthMonitorConfig = {}) {
    this.config = {
      enableAutoRepair: config.enableAutoRepair ?? false,
      maxReconnectAttempts: config.maxReconnectAttempts ?? 3,
      healthCheckIntervalMs: config.healthCheckIntervalMs || 60 * 1000, // 1分钟
    };
  }

  /**
   * 执行全面健康检查
   */
  async performHealthCheck(): Promise<HealthCheckResult> {
    const startTime = Date.now();
    const checks: HealthCheck[] = [];

    console.log('🏥 执行数据库健康检查...');

    try {
      // 1. 连接检查
      checks.push(await this.checkConnection());

      // 2. 完整性检查
      checks.push(await this.checkIntegrity());

      // 3. WAL 模式检查
      checks.push(await this.checkWALMode());

      // 4. 缓存检查
      checks.push(await this.checkCache());

      // 5. 文件大小检查
      checks.push(await this.checkFileSize());

      // 6. 表数量检查
      checks.push(await this.checkTables());

      // 7. 写入测试
      checks.push(await this.checkWriteAccess());

      // 记录历史
      this.recordHealthHistory(checks);

      const duration = Date.now() - startTime;

      console.log(
        `✅ 健康检查完成，耗时 ${duration}ms，${checks.filter((c) => c.status === 'pass').length}/${checks.length} 通过`
      );

      // 确定整体状态
      const failedCount = checks.filter((c) => c.status === 'fail').length;
      const warnCount = checks.filter((c) => c.status === 'warn').length;

      let overallStatus: 'healthy' | 'degraded' | 'unhealthy';

      if (failedCount > 0) {
        overallStatus = 'unhealthy';
      } else if (warnCount > 0 || failedCount === 0) {
        overallStatus = 'degraded';
      } else {
        overallStatus = 'healthy';
      }

      return {
        status: overallStatus,
        checks,
        timestamp: new Date(),
      };
    } catch (error) {
      console.error('❌ 健康检查失败:', error);

      return {
        status: 'unhealthy',
        checks: [
          {
            name: 'health_check',
            status: 'fail',
            message: (error as Error).message,
          },
        ],
        timestamp: new Date(),
      };
    }
  }

  /**
   * 检查数据库连接
   */
  private async checkConnection(): Promise<HealthCheck> {
    try {
      const isReady = this.db.isReady();
      const isConnected = this.db.getDatabase() !== null;

      return {
        name: 'connection',
        status: isConnected && isReady ? 'pass' : 'fail',
        message: isConnected && isReady ? '连接正常' : '数据库未初始化',
      };
    } catch (error) {
      return {
        name: 'connection',
        status: 'fail',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查数据库完整性
   */
  private async checkIntegrity(): Promise<HealthCheck> {
    try {
      const integrityOk = this.db.checkIntegrity();

      if (!integrityOk) {
        // 尝试自动修复
        if (this.config.enableAutoRepair) {
          console.warn('⚠️  检测到数据库损坏，尝试自动修复...');
          await this.attemptRepair();
        }

        // 重新检查
        const repairedOk = this.db.checkIntegrity();

        return {
          name: 'integrity',
          status: repairedOk ? 'warn' : 'fail',
          message: repairedOk
            ? '完整性问题已修复'
            : '数据库完整性检查失败',
        };
      }

      return {
        name: 'integrity',
        status: 'pass',
        message: '数据库完整性正常',
      };
    } catch (error) {
      return {
        name: 'integrity',
        status: 'fail',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查 WAL 模式
   */
  private async checkWALMode(): Promise<HealthCheck> {
    try {
      const isWAL = this.db.isWALMode();

      return {
        name: 'wal_mode',
        status: isWAL ? 'pass' : 'warn',
        message: isWAL ? 'WAL 模式已启用' : 'WAL 模式未启用，性能可能受限',
        metadata: { wal_enabled: isWAL },
      };
    } catch (error) {
      return {
        name: 'wal_mode',
        status: 'warn',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查缓存配置
   */
  private async checkCache(): Promise<HealthCheck> {
    try {
      const cacheSize = this.db.getCacheSize();
      const targetSize = 2 * 1024 * 1024; // 2MB for 2u2g

      const isWithinLimit = cacheSize <= targetSize;
      const cacheSizeMB = cacheSize / (1024 * 1024);

      return {
        name: 'cache_size',
        status: isWithinLimit ? 'pass' : 'warn',
        message: isWithinLimit
          ? `缓存大小正常: ${cacheSizeMB.toFixed(2)}MB`
          : `缓存大小超出 2u2g 限制: ${cacheSizeMB.toFixed(2)}MB`,
        metadata: {
          cache_bytes: cacheSize,
          cache_mb: cacheSizeMB.toFixed(2),
          target_mb: (targetSize / (1024 * 1024)).toFixed(2),
        },
      };
    } catch (error) {
      return {
        name: 'cache_size',
        status: 'fail',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查文件大小
   */
  private async checkFileSize(): Promise<HealthCheck> {
    try {
      const stats = this.db.getStats();
      const sizeMB = stats.size / (1024 * 1024);

      let status: 'pass' | 'warn' | 'fail';
      let message: string;

      if (sizeMB > 500) {
        // 大于 500MB 警告
        status = 'warn';
        message = `数据库文件较大: ${stats.sizeFormatted}，建议执行 VACUUM`;
      } else if (sizeMB > 1000) {
        // 大于 1GB 严重警告
        status = 'fail';
        message = `数据库文件过大: ${stats.sizeFormatted}，可能导致性能问题`;
      } else {
        status = 'pass';
        message = `数据库大小正常: ${stats.sizeFormatted}`;
      }

      return {
        name: 'file_size',
        status,
        message,
        metadata: {
          size_bytes: stats.size,
          size_formatted: stats.sizeFormatted,
          size_mb: sizeMB.toFixed(2),
        },
      };
    } catch (error) {
      return {
        name: 'file_size',
        status: 'fail',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查表数量和状态
   */
  private async checkTables(): Promise<HealthCheck> {
    try {
      const tables = this.db.all<{ name: string }>(
        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
      );

      const expectedTables = [
        'schema_version',
        'admin',
        'installation',
        'repository',
        'analysis',
        'analysis_job',
        'jobs',
        'webhook_event',
        'usage_metric',
      ];

      const missingTables = expectedTables.filter(
        (t) => !tables.some((table) => table.name === t)
      );

      if (missingTables.length > 0) {
        return {
          name: 'tables',
          status: 'fail',
          message: `缺失表: ${missingTables.join(', ')}`,
          metadata: {
            table_count: tables.length,
            missing_tables: missingTables,
          },
        };
      }

      return {
        name: 'tables',
        status: 'pass',
        message: `表结构正常 (${tables.length} 个表)`,
        metadata: {
          table_count: tables.length,
          expected_count: expectedTables.length,
        },
      };
    } catch (error) {
      return {
        name: 'tables',
        status: 'fail',
        message: (error as Error).message,
      };
    }
  }

  /**
   * 检查写入访问
   */
  private async checkWriteAccess(): Promise<HealthCheck> {
    try {
      // 尝试执行简单的写入操作
      const startTime = Date.now();
      const result = this.db.execute(
        'SELECT COUNT(*) as count FROM schema_version'
      );
      const duration = Date.now() - startTime;

      return {
        name: 'write_access',
        status: 'pass',
        message: '写入权限正常',
        metadata: {
          query_duration_ms: duration,
        },
      };
    } catch (error) {
      return {
        name: 'write_access',
        status: 'fail',
        message: `写入失败: ${(error as Error).message}`,
      };
    }
  }

  /**
   * 尝试修复数据库
   */
  private async attemptRepair(): Promise<boolean> {
    console.log('🔧 尝试修复数据库...');

    try {
      // SQLite 的 RECOVER 功能需要特定版本
      // 这里我们使用简单的方法：关闭并重新打开
      this.db.close();

      // 尝试导出和导入（如果可能）
      const dbPath = (this.db.getDatabase() as any).config?.path;

      // 短暂等待文件系统同步
      await new Promise((resolve) => setTimeout(resolve, 100));

      // 重新打开
      this.db.connect();

      console.log('✅ 数据库修复尝试完成');
      return true;
    } catch (error) {
      console.error('❌ 数据库修复失败:', error);
      return false;
    }
  }

  /**
   * 记录健康历史
   */
  private recordHealthHistory(checks: HealthCheck[]): void {
    const failedCount = checks.filter((c) => c.status === 'fail').length;
    const warnCount = checks.filter((c) => c.status === 'warn').length;

    let status: string;

    if (failedCount > 0) {
      status = 'unhealthy';
    } else if (warnCount > 0) {
      status = 'degraded';
    } else {
      status = 'healthy';
    }

    this.healthHistory.push({
      status,
      timestamp: new Date(),
    });

    // 只保留最近 100 条记录
    if (this.healthHistory.length > 100) {
      this.healthHistory = this.healthHistory.slice(-100);
    }
  }

  /**
   * 获取健康历史
   */
  getHealthHistory(limit = 50): Array<{
    status: string;
    timestamp: Date;
  }> {
    return this.healthHistory.slice(-limit);
  }

  /**
   * 获取健康统计
   */
  getHealthStats(): {
    total: number;
    healthy: number;
    degraded: number;
    unhealthy: number;
    recentTrend: string;
  } {
    const healthy = this.healthHistory.filter((h) => h.status === 'healthy').length;
    const degraded = this.healthHistory.filter((h) => h.status === 'degraded').length;
    const unhealthy = this.healthHistory.filter((h) => h.status === 'unhealthy').length;
    const total = this.healthHistory.length;

    // 计算趋势（最近 10 次检查）
    const recent = this.healthHistory.slice(-10);
    let trend = 'stable';
    if (recent.length >= 2) {
      const recentUnhealthy = recent.filter((h) => h.status === 'unhealthy').length;
      if (recentUnhealthy >= 5) {
        trend = 'degrading';
      } else if (recentUnhealthy === 0) {
        trend = 'improving';
      }
    }

    return {
      total,
      healthy,
      degraded,
      unhealthy,
      recentTrend: trend,
    };
  }

  /**
   * 清空健康历史
   */
  clearHistory(): void {
    this.healthHistory = [];
    console.log('🧹 已清空健康历史记录');
  }

  /**
   * 启动定时健康检查
   */
  startMonitoring(callback?: (result: HealthCheckResult) => void): NodeJS.Timeout {
    console.log('⏰ 启动数据库健康监控...');

    return setInterval(async () => {
      const result = await this.performHealthCheck();
      if (callback) {
        callback(result);
      }

      // 如果状态不健康，记录警告
      if (result.status === 'unhealthy') {
        console.error('🚨 数据库健康状态: 不健康');
      } else if (result.status === 'degraded') {
        console.warn('⚠️  数据库健康状态: 降级');
      }
    }, this.config.healthCheckIntervalMs);
  }
}

/**
 * 获取健康监控器单例
 */
let healthMonitorInstance: DatabaseHealthMonitor | null = null;

export function getHealthMonitor(config?: HealthMonitorConfig): DatabaseHealthMonitor {
  if (!healthMonitorInstance) {
    healthMonitorInstance = new DatabaseHealthMonitor(config);
  }
  return healthMonitorInstance;
}
