# ============================================
# CodaGraph-lite 环境变量配置
# ============================================

# ============================================
# 服务器配置
# ============================================
# 前端服务端口
FRONTEND_PORT=3000

# 后端服务端口
BACKEND_PORT=7900

# Node.js 内存限制 (2u2g 服务器关键配置)
NODE_OPTIONS=--max-old-space-size=200

# ============================================
# 数据库配置 (SQLite)
# ============================================
# SQLite 数据库文件路径
DATABASE_PATH=./data/codagraph-lite.db

# SQLite 缓存大小 (2u2g 服务器优化: 2MB)
SQLITE_CACHE_SIZE=-2000

# ============================================
# 任务队列配置
# ============================================
# 工作进程数量 (2u2g 服务器关键: 必须为 1)
WORKER_COUNT=1

# 禁用并发任务 (2u2g 服务器关键: 必须为 false)
ENABLE_CONCURRENT_JOBS=false

# 任务队列轮询间隔 (秒)
JOB_QUEUE_POLL_INTERVAL=2

# ============================================
# 单管理员认证配置
# ============================================
# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码 (生产环境请使用强密码)
ADMIN_PASSWORD=changeme

# Session 过期时间 (秒)
SESSION_TIMEOUT=86400

# ============================================
# OAuth 集成配置
# ============================================

# GitHub OAuth 配置
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:7900/api/oauth/github/callback

# Gitee OAuth 配置
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_CALLBACK_URL=http://localhost:7900/api/oauth/gitee/callback

# GitLab OAuth 配置
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
GITLAB_CALLBACK_URL=http://localhost:7900/api/oauth/gitlab/callback

# ============================================
# Python Agent 配置
# ============================================

# Context Agent 配置
CONTEXT_AGENT_PORT=50052
CONTEXT_AGENT_HOST=localhost
# Context Agent 超时 (毫秒)
AGENT_TIMEOUT_CONTEXT=300000

# Review Agent 配置
REVIEW_AGENT_PORT=50051
REVIEW_AGENT_HOST=localhost
# Review Agent 超时 (毫秒)
AGENT_TIMEOUT_REVIEW=600000

# Python 内存限制 (2u2g 服务器关键配置)
PYTHON_MEMORY_LIMIT=300m

# ============================================
# git-ai 配置
# ============================================

# git-ai CLI 路径
GIT_AI_BIN=/usr/local/bin/git-ai

# git-ai 内存限制 (2u2g 服务器优化: 256MB)
GIT_AI_MAX_MEMORY=256m

# 仓库工作空间路径
WORKSPACE_ROOT=/tmp/repos

# ============================================
# 资源监控配置 (2u2g 服务器优化)
# ============================================

# 启用 Swap 警告
ENABLE_SWAP_WARNING=true

# 内存警告阈值 (百分比)
MEMORY_WARNING_THRESHOLD=80

# 内存严重阈值 (百分比)
MEMORY_CRITICAL_THRESHOLD=95

# ============================================
# 日志配置
# ============================================

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 日志文件路径
LOG_PATH=./logs

# 启用请求日志
ENABLE_REQUEST_LOGGING=true

# ============================================
# 安全配置
# ============================================

# Session 密钥 (生产环境请更改)
SESSION_SECRET=changeme_to_secure_random_string

# 启用 HTTPS (生产环境建议启用)
ENABLE_HTTPS=false

# HTTPS 证书路径 (启用 HTTPS 时需要)
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# ============================================
# Webhook 配置
# ============================================

# Webhook 密钥 (用于签名验证)
WEBHOOK_SECRET=changeme_to_random_webhook_secret

# ============================================
# CORS 配置
# ============================================

# 允许的源 (逗号分隔)
CORS_ORIGINS=http://localhost:3000

# 允许的方法
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ============================================
# LLM 服务配置
# ============================================

# LLM 提供商 (openai, anthropic, deepseek, etc.)
LLM_PROVIDER=openai

# LLM API 密钥
LLM_API_KEY=your_llm_api_key

# LLM 模型名称
LLM_MODEL=gpt-4

# LLM API 端点 (如果使用自定义端点)
LLM_API_BASE_URL=

# LLM 最大重试次数
LLM_MAX_RETRIES=3

# ============================================
# 其他配置
# ============================================

# 时区
TIMEZONE=Asia/Shanghai

# 区域设置
LOCALE=zh-CN

# 数据库备份路径
BACKUP_PATH=./backups

# 启用自动备份
ENABLE_AUTO_BACKUP=true

# 备份间隔 (小时)
BACKUP_INTERVAL_HOURS=24
